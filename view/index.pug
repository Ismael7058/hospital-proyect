doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Hospital Horizon
    link(rel="stylesheet", href="/css/bootstrap.min.css")
    link(rel="stylesheet", href="/css/style.css")
  body.body
    include compartido/header

    section.row.h-100.section
      if user 
        include compartido/aside
        main.col-10.main-bg-img
          include compartido/welcome
      else 
        main.col-12.main-bg-img.d-flex
          include compartido/welcome

    if !user
      // Modal Login
      div#modalLogin.modal.fade(tabindex="-1")
        .modal-dialog.modal-dialog-centered
          .modal-content
            .d-flex.justify-content-end
              button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
            .modal-header.justify-content-center.pt-0
              h5.modal-title Iniciar Sesión
            .modal-body
              form(action="", method="post")
                .mb-3
                  label.pb-2(for="email") Dirección de correo electrónico
                  input.form-control.bg-color-input(type="email", required)
                .mb-3
                  label.pb-2(for="password") Contraseña
                  input.form-control.bg-color-input(type="password", required)
                button.btn.btn-primary.w-100.mt-3(type="submit") Iniciar Sesión
    script(src="/js/bootstrap.bundle.min.js")
